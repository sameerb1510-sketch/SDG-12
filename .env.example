# ===================================================================
# EcoWaste Navigator - Environment Configuration Example
# Copy this file to .env and configure your environment values.
# NEVER commit .env to Git or expose your API key to frontend code!
# ===================================================================

# Port for the Express backend server (default 5000)
PORT=5000

# Google Gemini API Key from Google AI Studio (Free Tier available)
# Obtain from: https://aistudio.google.com/app/apikey
# Leave empty or set to placeholder to run in Offline/Transparent Demo Mode.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Configurable Gemini Model Identifier
# Supported modern multimodal models include:
# - gemini-2.5-flash (Recommended default)
# - gemini-1.5-flash
# - gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# LAN Classroom Demonstration Mode (Optional: true / false)
# When set to true or started with `npm run demo:network`, Express binds to 0.0.0.0
# and serves both frontend build and /api endpoints on a single port for classroom Wi-Fi.
LAN_MODE=false
